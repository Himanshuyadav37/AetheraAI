# Groq API Keys
GROQ_KEY_1=your_groq_api_key_1
GROQ_KEY_2=your_groq_api_key_2
GROQ_KEY_3=your_groq_api_key_3

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=devpilot

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_MINUTES=60
ADMIN_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=https://your-frontend.example

# Production database. Do not use localhost in production.
ENV=development

# Automation providers
OPENAI_API_KEY=your_openai_compatible_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GITHUB_TOKEN=your_server_side_github_token
AUTOMATION_GITHUB_WEBHOOK_SECRET=your_webhook_secret
LINEAR_API_KEY=your_linear_api_key
LINEAR_TEAM_ID=your_linear_team_id
AUTOMATION_SLACK_BOT_TOKEN=your_slack_bot_token
AUTOMATION_SLACK_DEFAULT_CHANNEL=#alerts
AUTOMATION_TEST_LINEAR_TEAM_ID=your_test_linear_team_id
AUTOMATION_TEST_SLACK_CHANNEL=#aethera-test

# Vector Store (pinecone or chroma)
VECTOR_STORE=pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=nexusai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ChromaDB (Local Fallback)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# n8n Automation Webhook
N8N_SIGNUP_WEBHOOK_URL=your_n8n_signup_webhook_url_here