{
  "name": "NexusAI Feedback Form Workflow (Form Trigger)",
  "nodes": [
    {
      "parameters": {
        "path": "nexusai-feedback",
        "formTitle": "NexusAI — Experience & Improvement Feedback",
        "formDescription": "Help us build the next generation of NexusAI! Share your experience, any suggestions for improvement, and features you'd like to see. Takes under 1 minute.",
        "formSubmittedText": "🎉 Thank you for your feedback! Your ideas and suggestions have been shared directly with our engineering team.",
        "responseMode": "lastNode",
        "options": {},
        "formFields": {
          "values": [
            {
              "fieldLabel": "Your Name",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "Himanshu Rao"
            },
            {
              "fieldLabel": "Registered Email",
              "fieldType": "email",
              "requiredField": true,
              "placeholder": "developer@example.com"
            },
            {
              "fieldLabel": "Overall Experience Rating (1-5)",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "⭐⭐⭐⭐⭐ (5/5) — Loved it! Smooth & powerful"
                  },
                  {
                    "option": "⭐⭐⭐⭐ (4/5) — Very good, minor tweaks needed"
                  },
                  {
                    "option": "⭐⭐⭐ (3/5) — Average / Okay"
                  },
                  {
                    "option": "⭐⭐ (2/5) — Needs noticeable improvement"
                  },
                  {
                    "option": "⭐ (1/5) — Poor / Experienced errors"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Which feature did you explore first?",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Engineer AI (Autonomous coding & preview)"
                  },
                  {
                    "option": "Research AI (Deep knowledge & report generation)"
                  },
                  {
                    "option": "Automation Agent (Workflows & Pipelines)"
                  },
                  {
                    "option": "Education AI (Interactive programming tutoring)"
                  },
                  {
                    "option": "MCP Registry & Custom Agents"
                  },
                  {
                    "option": "General UI & Dashboard"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Koi suggestion hai improvement ka? (Suggestions for Improvement)",
              "fieldType": "textarea",
              "requiredField": true,
              "placeholder": "What could be improved? Any UX friction, faster speed, better prompts, or clarity?"
            },
            {
              "fieldLabel": "What new features or tools would you like us to add next?",
              "fieldType": "textarea",
              "requiredField": false,
              "placeholder": "e.g., WhatsApp bot, Telegram bot, local LLMs, Git integration, etc."
            },
            {
              "fieldLabel": "Did you encounter any bugs, glitches, or errors?",
              "fieldType": "dropdown",
              "requiredField": false,
              "fieldOptions": {
                "values": [
                  {
                    "option": "No — everything worked smoothly! 🎉"
                  },
                  {
                    "option": "Yes — encountered a bug / error ⚠️"
                  }
                ]
              }
            },
            {
              "fieldLabel": "If you faced any bug or error, please describe it (optional):",
              "fieldType": "textarea",
              "requiredField": false,
              "placeholder": "Describe what you clicked or what went wrong..."
            },
            {
              "fieldLabel": "How likely are you to recommend NexusAI to a colleague? (1 - 10)",
              "fieldType": "number",
              "requiredField": false,
              "placeholder": "10 = Definitely recommend, 1 = Not likely"
            }
          ]
        }
      },
      "id": "form-trigger-nexusai-01",
      "name": "N8N Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "nexusai-feedback"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/smtp/email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "<YOUR_BREVO_API_KEY>"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"sender\": {\n    \"name\": \"NexusAI Feedback Alert\",\n    \"email\": \"ydvhimanshu461@gmail.com\"\n  },\n  \"to\": [
    {
      \"email\": \"ydvhimanshu461@gmail.com\",
      \"name\": \"NexusAI Admin\"
    }
  ],
  \"subject\": \"New Feedback: {{ $json['Your Name'] }} ({{ $json['Overall Experience Rating (1-5)']?.split(' ')[0] || 'Feedback' }})\",
  \"htmlContent\": \"<div style=\\\"background-color: #0c0d0e; padding: 40px 15px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\\\">\\n  <div style=\\\"max-width: 540px; margin: 0 auto; background-color: #121214; border: 1px solid #27272a; border-radius: 12px; padding: 36px 30px; color: #ffffff;\\\">\\n    <div style=\\\"text-align: center; margin-bottom: 24px;\\\">\\n      <div style=\\\"font-size: 22px; font-weight: 700; letter-spacing: -0.03em; color: #ffffff;\\\">Nexus<span style=\\\"color: #a1a1aa;\\\">AI</span></div>\\n      <div style=\\\"font-size: 11px; color: #71717a; margin-top: 4px; letter-spacing: 0.05em; text-transform: uppercase;\\\">User Feedback Report</div>\\n    </div>\\n    <div style=\\\"border-top: 1px solid #27272a; margin-bottom: 24px;\\\"></div>\\n    <div style=\\\"font-size: 18px; font-weight: 600; color: #ffffff; margin-bottom: 6px; text-align: center;\\\">New Feedback Received 💬</div>\\n    <p style=\\\"color: #71717a; font-size: 12px; text-align: center; margin: 0 0 20px 0;\\\">Submitted via n8n 10-Minute Feedback Loop</p>\\n\\n    <div style=\\\"background-color: #18181b; border: 1px solid #27272a; border-radius: 10px; padding: 18px 20px; margin-bottom: 16px;\\\">\\n      <div style=\\\"margin-bottom: 8px; font-size: 14px; color: #d4d4d8;\\\"><strong>User:</strong> {{ $json['Your Name'] }} ({{ $json['Registered Email'] }})</div>\\n      <div style=\\\"margin-bottom: 8px; font-size: 14px; color: #d4d4d8;\\\"><strong>Rating:</strong> <span style=\\\"color: #fbbf24; font-weight: 600;\\\">{{ $json['Overall Experience Rating (1-5)'] }}</span></div>\\n      <div style=\\\"margin-bottom: 8px; font-size: 14px; color: #d4d4d8;\\\"><strong>Feature Tested:</strong> {{ $json['Which feature did you explore first?'] }}</div>\\n      <div style=\\\"font-size: 14px; color: #d4d4d8;\\\"><strong>NPS Score:</strong> {{ $json['How likely are you to recommend NexusAI to a colleague? (1 - 10)'] || 'N/A' }}/10</div>\\n    </div>\\n\\n    <div style=\\\"background-color: #18181b; border: 1px solid #27272a; border-radius: 10px; padding: 18px 20px; margin-bottom: 16px;\\\">\\n      <div style=\\\"font-size: 13px; font-weight: 600; color: #ffffff; margin-bottom: 8px;\\\">💡 Improvement Suggestions:</div>\\n      <div style=\\\"font-size: 14px; color: #d4d4d8; line-height: 1.6; white-space: pre-wrap;\\\">{{ $json['Koi suggestion hai improvement ka? (Suggestions for Improvement)'] }}</div>\\n    </div>\\n\\n    <div style=\\\"background-color: #18181b; border: 1px solid #27272a; border-radius: 10px; padding: 18px 20px; margin-bottom: 16px;\\\">\\n      <div style=\\\"font-size: 13px; font-weight: 600; color: #ffffff; margin-bottom: 8px;\\\">✨ Requested Features:</div>\\n      <div style=\\\"font-size: 14px; color: #a1a1aa; line-height: 1.6; white-space: pre-wrap;\\\">{{ $json['What new features or tools would you like us to add next?'] || 'None specified' }}</div>\\n    </div>\\n\\n    <div style=\\\"background-color: #18181b; border: 1px solid #27272a; border-radius: 10px; padding: 18px 20px; margin-bottom: 24px;\\\">\\n      <div style=\\\"font-size: 13px; font-weight: 600; color: #ef4444; margin-bottom: 8px;\\\">🐞 Bug Report:</div>\\n      <div style=\\\"font-size: 14px; color: #d4d4d8; margin-bottom: 4px;\\\">{{ $json['Did you encounter any bugs, glitches, or errors?'] }}</div>\\n      <div style=\\\"font-size: 13px; color: #a1a1aa; line-height: 1.5;\\\">{{ $json['If you faced any bug or error, please describe it (optional):'] || 'No details' }}</div>\\n    </div>\\n\\n    <div style=\\\"border-top: 1px solid #27272a; padding-top: 20px; text-align: center;\\\">\\n      <p style=\\\"color: #71717a; font-size: 12px; margin: 0 0 4px 0;\\\">\\n        <strong style=\\\"color: #a1a1aa;\\\">Aethera</strong> &bull; Intelligence, evolved\\n      </p>\\n      <p style=\\\"color: #52525b; font-size: 11px; margin: 0;\\\">\\n        NexusAI Automated Feedback Alerts &bull; Admin Inbox\\n      </p>\\n    </div>\\n  </div>\\n</div>\"\n}"
      },
      "id": "send-admin-feedback-email-01",
      "name": "Send Feedback Alert to Admin (Brevo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        300
      ]
    }
  ],
