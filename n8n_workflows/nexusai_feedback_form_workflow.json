{
  "name": "NexusAI Feedback Form Workflow (Form Trigger)",
  "nodes": [
    {
      "parameters": {
        "path": "nexusai-feedback",
        "formTitle": "NexusAI — Experience & Improvement Feedback",
        "formDescription": "Help us build the next generation of NexusAI! Share your experience, any suggestions for improvement, and features you'd like to see. Takes under 1 minute.",
        "formSubmittedText": "🎉 Thank you for your feedback! Your ideas and suggestions have been shared directly with our engineering team.",
        "responseMode": "lastNode",
        "options": {},
        "formFields": {
          "values": [
            {
              "fieldLabel": "Your Name",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "Himanshu Rao"
            },
            {
              "fieldLabel": "Registered Email",
              "fieldType": "email",
              "requiredField": true,
              "placeholder": "developer@example.com"
            },
            {
              "fieldLabel": "Overall Experience Rating (1-5)",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "⭐⭐⭐⭐⭐ (5/5) — Loved it! Smooth & powerful"
                  },
                  {
                    "option": "⭐⭐⭐⭐ (4/5) — Very good, minor tweaks needed"
                  },
                  {
                    "option": "⭐⭐⭐ (3/5) — Average / Okay"
                  },
                  {
                    "option": "⭐⭐ (2/5) — Needs noticeable improvement"
                  },
                  {
                    "option": "⭐ (1/5) — Poor / Experienced errors"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Which feature did you explore first?",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Engineer AI (Autonomous coding & preview)"
                  },
                  {
                    "option": "Research AI (Deep knowledge & report generation)"
                  },
                  {
                    "option": "Automation Agent (Workflows & Pipelines)"
                  },
                  {
                    "option": "Education AI (Interactive programming tutoring)"
                  },
                  {
                    "option": "MCP Registry & Custom Agents"
                  },
                  {
                    "option": "General UI & Dashboard"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Koi suggestion hai improvement ka? (Suggestions for Improvement)",
              "fieldType": "textarea",
              "requiredField": true,
              "placeholder": "What could be improved? Any UX friction, faster speed, better prompts, or clarity?"
            },
            {
              "fieldLabel": "What new features or tools would you like us to add next?",
              "fieldType": "textarea",
              "requiredField": false,
              "placeholder": "e.g., WhatsApp bot, Telegram bot, local LLMs, Git integration, etc."
            },
            {
              "fieldLabel": "Did you encounter any bugs, glitches, or errors?",
              "fieldType": "dropdown",
              "requiredField": false,
              "fieldOptions": {
                "values": [
                  {
                    "option": "No — everything worked smoothly! 🎉"
                  },
                  {
                    "option": "Yes — encountered a bug / error ⚠️"
                  }
                ]
              }
            },
            {
              "fieldLabel": "If you faced any bug or error, please describe it (optional):",
              "fieldType": "textarea",
              "requiredField": false,
              "placeholder": "Describe what you clicked or what went wrong..."
            },
            {
              "fieldLabel": "How likely are you to recommend NexusAI to a colleague? (1 - 10)",
              "fieldType": "number",
              "requiredField": false,
              "placeholder": "10 = Definitely recommend, 1 = Not likely"
            }
          ]
        }
      },
      "id": "form-trigger-nexusai-01",
      "name": "N8N Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "nexusai-feedback"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/smtp/email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "<YOUR_BREVO_API_KEY>"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"sender\": {\n    \"name\": \"NexusAI Feedback Alert\",\n    \"email\": \"ydvhimanshu461@gmail.com\"\n  },\n  \"to\": [\n    {\n      \"email\": \"ydvhimanshu461@gmail.com\",\n      \"name\": \"NexusAI Admin\"\n    }\n  ],\n  \"subject\": \"🔥 New User Feedback from {{ $json['Your Name'] }} ({{ $json['Overall Experience Rating (1-5)']?.split(' ')[0] || 'Feedback' }})\",\n  \"htmlContent\": \"<div style=\\\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 650px; margin: 0 auto; padding: 35px 25px; border: 1px solid #1e293b; border-radius: 16px; background-color: #0f172a; color: #ffffff;\\\">\\n  <h2 style=\\\"color: #8b5cf6; margin: 0 0 10px 0;\\\">🚀 New User Feedback Received</h2>\\n  <p style=\\\"color: #94a3b8; font-size: 14px; margin-bottom: 25px;\\\">Submitted via NexusAI n8n 10-Minute Feedback Loop</p>\\n  \\n  <div style=\\\"background-color: #1e293b; padding: 18px 22px; border-radius: 10px; margin-bottom: 20px; border-left: 4px solid #38bdf8;\\\">\\n    <p style=\\\"margin: 6px 0; color: #cbd5e1; font-size: 15px;\\\"><strong>User:</strong> {{ $json['Your Name'] }} ({{ $json['Registered Email'] }})</p>\\n    <p style=\\\"margin: 6px 0; color: #cbd5e1; font-size: 15px;\\\"><strong>Rating:</strong> <span style=\\\"color: #fbbf24; font-weight: bold;\\\">{{ $json['Overall Experience Rating (1-5)'] }}</span></p>\\n    <p style=\\\"margin: 6px 0; color: #cbd5e1; font-size: 15px;\\\"><strong>Primary Feature Tested:</strong> {{ $json['Which feature did you explore first?'] }}</p>\\n    <p style=\\\"margin: 6px 0; color: #cbd5e1; font-size: 15px;\\\"><strong>NPS Score:</strong> {{ $json['How likely are you to recommend NexusAI to a colleague? (1 - 10)'] || 'N/A' }}/10</p>\\n  </div>\\n\\n  <div style=\\\"background-color: #131d33; padding: 18px 22px; border-radius: 10px; margin-bottom: 20px; border-left: 4px solid #a855f7;\\\">\\n    <h3 style=\\\"color: #a855f7; margin: 0 0 10px 0; font-size: 16px;\\\">💡 Improvement Suggestions:</h3>\\n    <p style=\\\"color: #f1f5f9; font-size: 15px; line-height: 1.6; white-space: pre-wrap; margin: 0;\\\">{{ $json['Koi suggestion hai improvement ka? (Suggestions for Improvement)'] }}</p>\\n  </div>\\n\\n  <div style=\\\"background-color: #131d33; padding: 18px 22px; border-radius: 10px; margin-bottom: 20px; border-left: 4px solid #3b82f6;\\\">\\n    <h3 style=\\\"color: #3b82f6; margin: 0 0 10px 0; font-size: 16px;\\\">✨ Requested Features:</h3>\\n    <p style=\\\"color: #cbd5e1; font-size: 15px; line-height: 1.6; white-space: pre-wrap; margin: 0;\\\">{{ $json['What new features or tools would you like us to add next?'] || 'None specified' }}</p>\\n  </div>\\n\\n  <div style=\\\"background-color: #131d33; padding: 18px 22px; border-radius: 10px; margin-bottom: 25px; border-left: 4px solid #ef4444;\\\">\\n    <h3 style=\\\"color: #ef4444; margin: 0 0 10px 0; font-size: 16px;\\\">🐞 Bug / Error Report:</h3>\\n    <p style=\\\"color: #cbd5e1; font-size: 15px; margin: 0 0 6px 0;\\\"><strong>Faced Bugs:</strong> {{ $json['Did you encounter any bugs, glitches, or errors?'] }}</p>\\n    <p style=\\\"color: #94a3b8; font-size: 14px; line-height: 1.5; margin: 0;\\\">{{ $json['If you faced any bug or error, please describe it (optional):'] || 'No details provided.' }}</p>\\n  </div>\\n\\n  <hr style=\\\"border: 0; border-top: 1px solid #1e293b; margin: 25px 0 15px 0;\\\" />\\n  <p style=\\\"color: #64748b; font-size: 12px; text-align: center; margin: 0;\\\">NexusAI Automated n8n Admin Alerts &bull; Sent to admin inbox</p>\\n</div>\"\n}"
      },
      "id": "send-admin-feedback-email-01",
      "name": "Send Feedback Alert to Admin (Brevo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        300
      ]
    }
  ],
  "connections": {
    "N8N Form Trigger": {
      "main": [
        [
          {
            "node": "Send Feedback Alert to Admin (Brevo)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
